# Resend — powers the contact form via the /api/contact serverless function.
# Server-side only. Do NOT add a VITE_ prefix: that would ship the key to the browser.

# API key from https://resend.com/api-keys  (starts with re_)
RESEND_API_KEY=re_your_resend_api_key_here

# Where contact form submissions are delivered.
CONTACT_TO_EMAIL=you@example.com

# Optional. Sender address shown on the notification.
# Resend's shared onboarding sender only delivers to your own Resend account
# email. Once you verify a domain, switch this to something like
# "Portfolio <contact@yourdomain.com>".
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>
